install.packages('rdrobust')
library(tidyverse)
library(lubridate)
library(rdrobust)
box_office_data <- read.csv("cleaned_box_office.csv")
print(head(box_office_data))
print(str(box_office_data))
box_office_plot <- box_office_data %>% ggplot(aes(x=Year, y =Worldwide.Revenue....)) +
geom_point()
box_office_plot # display plot
cutpoint<- 2011 #make a variable storing a date
# Next, add the vertical dashed line at the cutpoint (Jan. 1, 2011):
box_office_plot_cp <- box_office_plot + geom_vline(xintercept = as.numeric(cutpoint), linetype = "dashed")
box_office_plot_cp
#add column to crash_data in order to create before and after groups relative to the cutpoint
box_office_data_grouped  <- box_office_data %>%  mutate(group = case_when( Year < cutpoint ~ "before", Year >= cutpoint ~ "after_2011"))
#create ggplot
box_office_plot_cp_lm <- box_office_data_grouped %>% ggplot(aes(x=Year, y = Worldwide.Revenue....)) +
geom_point() +
geom_vline(xintercept = as.numeric(cutpoint), linetype = "dashed") +
geom_smooth(aes(group = group), color = "black", method = lm)
box_office_plot_cp_lm  # display plot
cutpoint<- 2012 #make a variable storing a date
# Next, add the vertical dashed line at the cutpoint (Jan. 1, 2011):
box_office_plot_cp <- box_office_plot + geom_vline(xintercept = as.numeric(cutpoint), linetype = "dashed")
box_office_plot_cp
#add column to crash_data in order to create before and after groups relative to the cutpoint
box_office_data_grouped  <- box_office_data %>%  mutate(group = case_when( Year < cutpoint ~ "before", Year >= cutpoint ~ "after_2012"))
#create ggplot
box_office_plot_cp_lm <- box_office_data_grouped %>% ggplot(aes(x=Year, y = Worldwide.Revenue....)) +
geom_point() +
geom_vline(xintercept = as.numeric(cutpoint), linetype = "dashed") +
geom_smooth(aes(group = group), color = "black", method = lm)
box_office_plot_cp_lm  # display plot
