install.packages('rdrobust')
library(tidyverse)
library(lubridate)
library(rdrobust)
box_office_data <- read.csv("cleaned_box_office.csv")
print(head(box_office_data))
print(str(box_office_data))
box_office_plot <- box_office_data %>% ggplot(aes(x=Year, y =Worldwide.Revenue....)) +
geom_point()
box_office_plot # display plot
cutpoint<- 2011.5 #make a variable storing a date
# Next, add the vertical dashed line at the cutpoint (Jan. 1, 2011):
box_office_plot_cp <- box_office_plot + geom_vline(xintercept = as.numeric(cutpoint), linetype = "dashed")
box_office_plot_cp
#add column to crash_data in order to create before and after groups relative to the cutpoint
box_office_data_grouped  <- box_office_data %>%  mutate(group = case_when( Year < cutpoint ~ "before", Year >= cutpoint ~ "after_2011"))
#create ggplot
box_office_plot_cp_lm <- box_office_data_grouped %>% ggplot(aes(x=Year, y = Worldwide.Revenue....)) +
geom_point() +
geom_vline(xintercept = as.numeric(cutpoint), linetype = "dashed") +
geom_smooth(aes(group = group), color = "black", method = lm)
box_office_plot_cp_lm  # display plot
bandwidths <- (rdbwselect(y=box_office_data$Worldwide.Revenue...., x= as.numeric(box_office_data$Year), c = as.numeric(cutpoint)))
bandwidths$bws #show the bandwidths
box_office_plot + geom_vline(xintercept = as.numeric(cutpoint), linetype = "dashed") + geom_vline(xintercept = as.numeric(cutpoint) + c(bw, -bw))
bw <- bandwidths$bws[1][1]
box_office_plot + geom_vline(xintercept = as.numeric(cutpoint), linetype = "dashed") + geom_vline(xintercept = as.numeric(cutpoint) + c(bw, -bw))
box_office_bw <- box_office_data_grouped %>% filter(as.numeric(Year) > (as.numeric(cutpoint) -bw) & as.numeric(Date) < (as.numeric(cutpoint)+bw))
rlang::last_trace()
rlang::last_trace(drop = FALSE)
box_office_bw <- box_office_data_grouped %>% filter(as.numeric(Year) > (as.numeric(cutpoint) -bw) & as.numeric(Date) < (as.numeric(cutpoint)+bw))
box_office_bw <- box_office_data_grouped %>% filter(Year > (as.numeric(cutpoint) -bw) & as.numeric(Date) < (as.numeric(cutpoint)+bw))
box_office_bw <- box_office_data_grouped %>% filter(as.numeric(Year) > (as.numeric(cutpoint) -bw) & as.numeric(Year) < (as.numeric(cutpoint)+bw))
box_office_plot + geom_vline(xintercept = as.numeric(cutpoint), linetype = "dashed") + geom_vline(xintercept = as.numeric(cutpoint) + c(bw, -bw)) + geom_smooth(data = box_office_bw, aes(x = Year, y = Worldwide.Revenue...., group = group), color = 'black', method = lm)
install.packages('rdrobust')
library(tidyverse)
library(lubridate)
library(rdrobust)
box_office_data <- read.csv("cleaned_box_office.csv")
print(head(box_office_data))
print(str(box_office_data))
box_office_plot <- box_office_data %>% ggplot(aes(x=Year, y =Worldwide.Revenue....)) +
geom_point()
box_office_plot # display plot
cutpoint<- 2011.5 #make a variable storing a date
# Next, add the vertical dashed line at the cutpoint (Jan. 1, 2011):
box_office_plot_cp <- box_office_plot + geom_vline(xintercept = as.numeric(cutpoint), linetype = "dashed")
box_office_plot_cp
#add column to crash_data in order to create before and after groups relative to the cutpoint
box_office_data_grouped  <- box_office_data %>%  mutate(group = case_when( Year < cutpoint ~ "before", Year >= cutpoint ~ "after_2011"))
#create ggplot
box_office_plot_cp_lm <- box_office_data_grouped %>% ggplot(aes(x=Year, y = Worldwide.Revenue....)) +
geom_point() +
geom_vline(xintercept = as.numeric(cutpoint), linetype = "dashed") +
geom_smooth(aes(group = group), color = "black", method = lm)
box_office_plot_cp_lm  # display plot
bandwidths <- (rdbwselect(y=box_office_data$Worldwide.Revenue...., x= as.numeric(box_office_data$Year), c = as.numeric(cutpoint)))
bandwidths$bws #show the bandwidths
bw <- bandwidths$bws[1][1]
box_office_plot + geom_vline(xintercept = as.numeric(cutpoint), linetype = "dashed") + geom_vline(xintercept = as.numeric(cutpoint) + c(bw, -bw))
box_office_bw <- box_office_data_grouped %>% filter(as.numeric(Year) > (as.numeric(cutpoint) -bw) & as.numeric(Year) < (as.numeric(cutpoint)+bw))
box_office_plot + geom_vline(xintercept = as.numeric(cutpoint), linetype = "dashed") + geom_vline(xintercept = as.numeric(cutpoint) + c(bw, -bw)) + geom_smooth(data = box_office_bw, aes(x = Year, y = Worldwide.Revenue...., group = group), color = 'black', method = lm)
